# Browser-facing configuration for apps/web/.env.local.
# NEXT_PUBLIC_* values are exposed to the browser; never put private keys here.

# Required for real RainbowKit wallet connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Browser-facing Supabase configuration. This is not the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only organization and wallet-authentication configuration.
# Generate AUTH_SECRET with: openssl rand -base64 32
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=
# Optional when the app is behind a proxy; otherwise the request origin is used.
AUTH_APP_URL=http://localhost:3000
# Optional server-side override for HSK reads; the canonical default is used when blank.
HSK_TESTNET_RPC_URL=

# Optional server-only AI Grant Builder provider (HAS-16).
# Leave AI_API_KEY blank to keep the feature on its offline drafter: the wizard,
# the presets, and the demo all work without a provider.
# Any OpenAI-compatible /chat/completions endpoint works — xAI, OpenRouter,
# DeepSeek, Zhipu, or a local Ollama/LM Studio server.
# Never prefix these with NEXT_PUBLIC_.
AI_API_KEY=
# Defaults to https://api.x.ai/v1 when blank.
AI_BASE_URL=
# Defaults to grok-4.6 when blank.
AI_MODEL=
