# Browser-facing configuration for apps/web/.env.local.
# NEXT_PUBLIC_* values are exposed to the browser; never put private keys here.

# Required for real RainbowKit wallet connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Browser-facing Supabase configuration. This is not the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only organization and wallet-authentication configuration.
# Generate AUTH_SECRET with: openssl rand -base64 32
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=
# Optional when the app is behind a proxy; otherwise the request origin is used.
AUTH_APP_URL=http://localhost:3000
# Optional server-side override for HSK reads; the canonical default is used when blank.
HSK_TESTNET_RPC_URL=
# Optional organization-sponsored first-claim relayer. Fund this throwaway
# HSK Testnet account and keep the key server-only; never expose it as NEXT_PUBLIC_*.
SPONSORED_CLAIM_RELAYER_PRIVATE_KEY=
