{
  "name": "hashvest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm contracts:test && node --test packages/web3/scripts/*.test.mjs scripts/*.test.mjs && pnpm --filter @hashvest/web test",
    "boundary:check": "node scripts/check-boundary.mjs",
    "format": "prettier --write . && pnpm --dir packages/contracts exec forge fmt",
    "format:check": "prettier --check . && pnpm --dir packages/contracts exec forge fmt --check",
    "contracts:build": "pnpm --dir packages/contracts build",
    "contracts:test": "pnpm --dir packages/contracts test",
    "contracts:sync": "pnpm contracts:build && node packages/web3/scripts/sync-contracts.mjs",
    "contracts:sync:check": "pnpm contracts:build && node packages/web3/scripts/sync-contracts.mjs --check",
    "contracts:sync:addresses": "node packages/web3/scripts/sync-contracts.mjs --addresses",
    "contracts:deploy:testnet": "dotenv -e packages/contracts/.env -- node packages/web3/scripts/deploy-testnet.mjs",
    "contracts:smoke:testnet": "dotenv -e packages/contracts/.env -- node packages/web3/scripts/smoke-testnet.mjs",
    "contracts:verify:testnet": "dotenv -e packages/contracts/.env -- node packages/web3/scripts/verify-testnet.mjs",
    "demo:testnet": "dotenv -e packages/contracts/.env -- node packages/web3/scripts/demo-testnet.mjs",
    "rehearsal:check": "node packages/web3/scripts/rehearsal-check.mjs"
  },
  "devDependencies": {
    "dotenv-cli": "11.0.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}
