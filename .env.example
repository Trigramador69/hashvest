# Copy this file to .env for Foundry commands and to apps/web/.env.local
# for browser-facing configuration. Never commit the copied files.

# WalletConnect Cloud project ID. Required for real wallet connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional until the off-chain data model is defined.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public HSK RPC endpoints used by Foundry. The web3 package includes these
# same public defaults for the browser transport.
HSK_MAINNET_RPC_URL=https://mainnet.hsk.xyz
HSK_TESTNET_RPC_URL=https://testnet.hsk.xyz

# Required only for testnet deployment. Use a funded throwaway deployer key.
DEPLOYER_PRIVATE_KEY=
