# Browser-facing configuration for apps/web/.env.local.
# NEXT_PUBLIC_* values are exposed to the browser; never put private keys here.

# Required for real RainbowKit wallet connections.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Browser-facing Supabase configuration. This is not the authorization boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only organization and wallet-authentication configuration.
# Generate AUTH_SECRET with: openssl rand -base64 32
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=
# Optional when the app is behind a proxy; otherwise the request origin is used.
AUTH_APP_URL=http://localhost:3000
# Optional server-side override for HSK reads; the canonical default is used when blank.
HSK_TESTNET_RPC_URL=

# Optional server-only AI Grant Builder provider (HAS-16).
# Leave AI_API_KEY blank to keep the feature on its offline drafter: the wizard,
# the presets, and the demo all work without a provider.
# Any OpenAI-compatible /chat/completions endpoint works — Groq, xAI, OpenRouter,
# DeepSeek, Zhipu, or a local Ollama/LM Studio server.
# Never prefix these with NEXT_PUBLIC_.
AI_API_KEY=
# Defaults to https://api.groq.com/openai/v1 when blank.
AI_BASE_URL=
# Defaults to openai/gpt-oss-20b when blank. The model must honour
# response_format: json_schema, or every draft silently falls back to the
# offline drafter. See docs/ai-grant-builder.md for the measured matrix.
AI_MODEL=
# Optional output ceiling per draft. Defaults to 2500, which a reasoning model
# needs: it spends the budget thinking before it emits any content, and one
# that runs out mid-thought returns nothing. Lower it only when a provider tier
# rejects the request outright — Groq's free tier caps some models at 1000
# output tokens per minute.
AI_MAX_TOKENS=
